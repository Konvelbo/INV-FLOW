{
  "name": "essor",
  "version": "0.1.4",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently \"next dev\" \"npm run electron:dev\"",
    "electron:dev": "wait-on http://localhost:3000 && cross-env NODE_ENV=development electron .",
    "electron:build": "wait-on http://localhost:3000 && cross-env NODE_ENV=production electron-builder --dir",
    "electron:dist": "node scripts/electron-build.js && electron-builder",
    "build": "node -e \"const fs = require('fs'); const isVercel = !!process.env.VERCEL; if (fs.existsSync('.next')) fs.rmSync('.next', { recursive: true, force: true }); let moved = false; if (!isVercel && fs.existsSync('app/api')) { fs.renameSync('app/api', 'app/_api'); moved = true; } try { require('child_process').execSync('npx prisma generate && next build', {stdio: 'inherit'}); } finally { if (moved && fs.existsSync('app/_api')) fs.renameSync('app/_api', 'app/api'); }\"",
    "start": "next start",
    "lint": "eslint"
  },
  "build": {
    "appId": "essor",
    "productName": "essor",
    "executableName": "essor",
    "compression": "maximum",
    "directories": {
      "output": "dist"
    },
    "icon": "public/black-caractere-non-black.ico",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/black-caractere-non-black.ico"
    },
    "nsis": {
      "oneClick": true,
      "installerIcon": "public/black-caractere-non-black.ico",
      "uninstallerIcon": "public/black-caractere-non-black.ico",
      "license": "licence.md",
      "perMachine": false
    },
    "files": [
      "**/*",
      "src/p_client/**/*"
    ],
    "asarUnpack": [
      "src/p_client/*query_engine*"
    ],
    "publish": {
      "provider": "github",
      "owner": "Konvelbo",
      "repo": "INV-FLOW"
    }
  },
  "asar": true,
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.2.2",
    "@internationalized/date": "^3.11.0",
    "@prisma/client": "6.19",
    "@react-email/components": "^1.0.8",
    "@react-email/render": "^2.0.4",
    "@remixicon/react": "^4.9.0",
    "@tabler/icons-react": "^3.38.0",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^3.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/pg": "^8.18.0",
    "@types/web-push": "^3.6.4",
    "axios": "^1.13.6",
    "bcryptjs": "^3.0.3",
    "bson": "^7.2.0",
    "child_process": "^1.0.2",
    "class-variance-authority": "^0.7.1",
    "classnames": "^2.5.1",
    "cloudinary": "^2.9.0",
    "clsx": "^2.1.1",
    "daisyui": "^5.5.19",
    "date-fns": "^4.1.0",
    "dotenv": "^16.6.1",
    "electron-updater": "^6.8.3",
    "exceljs": "^4.4.0",
    "framer-motion": "^12.35.1",
    "jsonwebtoken": "^9.0.3",
    "jszip": "^3.10.1",
    "lucide-react": "^0.576.0",
    "motion": "^12.34.4",
    "next": "^16.1.6",
    "next-themes": "^0.4.6",
    "openai": "^6.25.0",
    "puppeteer": "^24.37.5",
    "radix-ui": "^1.4.3",
    "react": "19.2.3",
    "react-aria-components": "^1.15.1",
    "react-day-picker": "^9.14.0",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.71.2",
    "react-hot-toast": "^2.6.0",
    "react-phone-number-input": "^3.4.16",
    "recharts": "^3.8.0",
    "resend": "^6.9.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4",
    "uuid": "^13.0.0",
    "web-push": "^3.6.7",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "40.6.1",
    "electron-builder": "^26.8.1",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "prisma": "6.19",
    "shadcn": "^3.8.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "wait-on": "^9.0.4"
  }
}
