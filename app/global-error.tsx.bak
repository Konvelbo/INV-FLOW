"use client";

import React, { useEffect } from "react";

export default function GlobalError({
  error,
  reset,
}: {
  error: Error & { digest?: string };
  reset: () => void;
}) {
  useEffect(() => {
    // Log error to console - since it's a client component this happens in the browser/renderer
    console.error("[Global Error]", error);
  }, [error]);

  return (
    <html lang="fr">
      <body style={{ 
        backgroundColor: "#0a0a0a", 
        color: "#ffffff", 
        display: "flex", 
        alignItems: "center", 
        justifyContent: "center", 
        minHeight: "100vh", 
        margin: 0, 
        fontFamily: "sans-serif" 
      }}>
        <div style={{ 
          textAlign: "center", 
          padding: "40px", 
          backgroundColor: "#111", 
          borderRadius: "12px", 
          border: "1px solid #333",
          maxWidth: "500px" 
        }}>
          <h1 style={{ color: "#ef4444", fontSize: "24px", marginBottom: "16px" }}>
            Erreur Critique
          </h1>
          <p style={{ color: "#888", marginBottom: "24px" }}>
            Une erreur inattendue est survenue dans l'application. 
            Veuillez essayer de rafraîchir ou de retourner à l'accueil.
          </p>
          
          {error?.message && (
             <div style={{ 
               backgroundColor: "#000", 
               padding: "12px", 
               borderRadius: "8px", 
               marginBottom: "24px",
               fontSize: "12px",
               fontFamily: "monospace",
               color: "#ef4444",
               textAlign: "left"
             }}>
               {error.message}
             </div>
          )}

          <div style={{ display: "flex", gap: "12px", justifyContent: "center" }}>
            <button
              onClick={() => reset()}
              style={{
                backgroundColor: "#333",
                color: "white",
                border: "none",
                padding: "12px 24px",
                borderRadius: "8px",
                cursor: "pointer",
                fontWeight: "600"
              }}
            >
              Réessayer
            </button>
            <button
              onClick={() => {
                if (typeof window !== "undefined") window.location.href = "/";
              }}
              style={{
                backgroundColor: "#4f46e5",
                color: "white",
                border: "none",
                padding: "12px 24px",
                borderRadius: "8px",
                cursor: "pointer",
                fontWeight: "600"
              }}
            >
              Accueil
            </button>
          </div>
        </div>
      </body>
    </html>
  );
}
